# Скопируйте этот файл в .env:  cp .env.example .env
# Файл .env в git не попадает (он в .gitignore).

# Ключ для подписи сессий (cookie) и CSRF-токенов.
# Необязательный: если оставить пустым, приложение само сгенерирует ключ
# и сохранит его в файл .secret_key.
#
# Сгенерировать вручную:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
