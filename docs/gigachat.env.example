# Copy these settings to .env beside app.py. Never commit your real key.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
# Optional extra PEM chain. System roots and official CA auto-setup work without it.
# GIGACHAT_CA_BUNDLE=certificates/gigachat-ca.pem
GIGACHAT_LIMIT_BASIC=10
GIGACHAT_LIMIT_FAMILY_BASIC=30
GIGACHAT_LIMIT_PREMIUM=100
GIGACHAT_LIMIT_FAMILY_PREMIUM=300
