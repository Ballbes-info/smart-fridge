# Copy to .env beside app.py. Never commit your real key.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# API IDs, not the marketing names from the balance screen.
# Ordinary mode automatically chooses Lite or Pro; enhanced chooses Max or Ultra.
GIGACHAT_LITE_MODEL=GigaChat-2
GIGACHAT_PRO_MODEL=GigaChat-2-Pro
GIGACHAT_MAX_MODEL=GigaChat-2-Max
# Empty/absent: detect Ultra's exact available API ID using GET /models.
# To fix a particular version, first run: python -m services.gigachat_models --available
GIGACHAT_ULTRA_MODEL=
# Legacy GIGACHAT_MODEL / GIGACHAT_RECIPE_MODEL / GIGACHAT_ASSISTANT_MODEL
# no longer override every task: configure the four tier variables above instead.

# One simultaneous inference across threads/workers on this server.
# A bounded wait; timeout errors never cause automatic generation replay.
GIGACHAT_QUEUE_WAIT_SECONDS=25
# Optional common directory for workers/containers sharing one filesystem.
# GIGACHAT_QUEUE_DIR=/shared/instance
GIGACHAT_RESPONSE_TIMEOUT=90
# Optional extra trusted PEM certificate chain. TLS verification stays enabled.
# GIGACHAT_CA_BUNDLE=certificates/gigachat-ca.pem

# Label and product-photo allowances are independent of chat/recipes; both use Max.
GIGACHAT_LIMIT_BASIC=10
GIGACHAT_LIMIT_FAMILY_BASIC=30
GIGACHAT_LIMIT_PREMIUM=100
GIGACHAT_LIMIT_FAMILY_PREMIUM=300
GIGACHAT_PRODUCT_LIMIT_PREMIUM=20
GIGACHAT_PRODUCT_LIMIT_FAMILY_PREMIUM=60

# Ordinary chat: default 150 Premium / 300 Family Premium.
# Optional common override: GIGACHAT_ASSISTANT_LIMIT=150
# Enhanced chat: default 20 Premium / 40 Family Premium.
# Optional common override: GIGACHAT_ASSISTANT_ADVANCED_LIMIT=20

GIGACHAT_RECIPE_LIMIT_PREMIUM=100
GIGACHAT_RECIPE_LIMIT_FAMILY_PREMIUM=300
GIGACHAT_RECIPE_ADVANCED_LIMIT_PREMIUM=10
GIGACHAT_RECIPE_ADVANCED_LIMIT_FAMILY_PREMIUM=30
