# Copy these settings to .env beside app.py. Never commit your real key.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
# Optional extra PEM chain. System roots and official CA auto-setup work without it.
# GIGACHAT_CA_BUNDLE=certificates/gigachat-ca.pem
GIGACHAT_LIMIT_BASIC=10
GIGACHAT_LIMIT_FAMILY_BASIC=30
GIGACHAT_LIMIT_PREMIUM=100
GIGACHAT_LIMIT_FAMILY_PREMIUM=300

# Generation response timeout in seconds (20..120). No automatic timeout retry.
GIGACHAT_RESPONSE_TIMEOUT=90

# Product-photo limits, separate from label limits.
GIGACHAT_PRODUCT_LIMIT_PREMIUM=20
GIGACHAT_PRODUCT_LIMIT_FAMILY_PREMIUM=60

# Создание рецептов: тот же ключ GIGACHAT_CREDENTIALS, только в премиум-тарифах.
# Если модель не задана, используется GIGACHAT_MODEL.
GIGACHAT_RECIPE_MODEL=GigaChat-2-Pro
GIGACHAT_RECIPE_LIMIT_PREMIUM=100
GIGACHAT_RECIPE_LIMIT_FAMILY_PREMIUM=300
